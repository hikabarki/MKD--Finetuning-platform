  "components": {
    "schemas": {
      "ChatLoadRequest": {
        "properties": {
          "model_path": {
            "type": "string",
            "title": "Model Path"
          }
        },
        "type": "object",
        "required": [
          "model_path"
        ],
        "title": "ChatLoadRequest"
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage"
      },
      "ChatRequest": {
        "properties": {
          "model_path": {
            "type": "string",
            "maxLength": 500,
            "title": "Model Path",
            "default": ""
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "title": "Messages"
          },
          "image_base64": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 10000000
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Base64"
          },
          "max_tokens": {
            "type": "integer",
            "maximum": 4096.0,
            "minimum": 1.0,
            "title": "Max Tokens",
            "default": 256
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "ChatRequest"
      },
      "DatasetAddRequest": {
        "properties": {
          "source": {
            "type": "string",
            "maxLength": 500,
            "title": "Source"
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "instruction_col": {
            "type": "string",
            "maxLength": 100,
            "title": "Instruction Col",
            "default": ""
          },
          "response_col": {
            "type": "string",
            "maxLength": 100,
            "title": "Response Col",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "source"
        ],
        "title": "DatasetAddRequest"
      },
      "DatasetCleanRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "title": "Name"
          },
          "max_chars": {
            "type": "integer",
            "maximum": 2000000.0,
            "minimum": 1.0,
            "title": "Max Chars",
            "default": 32768
          },
          "val_ratio": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Val Ratio",
            "default": 0.01
          },
          "lang": {
            "type": "string",
            "maxLength": 10,
            "title": "Lang",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "DatasetCleanRequest"
      },
      "EvalStartRequest": {
        "properties": {
          "checkpoint": {
            "type": "string",
            "title": "Checkpoint"
          },
          "base_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Model"
          },
          "suite": {
            "type": "string",
            "title": "Suite",
            "default": "configs/eval_default.json"
          },
          "skip_mt_bench": {
            "type": "boolean",
            "title": "Skip Mt Bench",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "checkpoint"
        ],
        "title": "EvalStartRequest"
      },
      "ExportRequest": {
        "properties": {
          "checkpoint": {
            "type": "string",
            "title": "Checkpoint"
          },
          "quantize": {
            "type": "string",
            "title": "Quantize",
            "default": "none"
          },
          "merge": {
            "type": "boolean",
            "title": "Merge",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "checkpoint"
        ],
        "title": "ExportRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ModelAddRequest": {
        "properties": {
          "hf_model_id": {
            "type": "string",
            "maxLength": 200,
            "title": "Hf Model Id"
          },
          "local_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Local Name"
          }
        },
        "type": "object",
        "required": [
          "hf_model_id"
        ],
        "title": "ModelAddRequest"
      },
      "PublishRequest": {
        "properties": {
          "export_dir": {
            "type": "string",
            "title": "Export Dir"
          },
          "hf_repo": {
            "type": "string",
            "title": "Hf Repo"
          },
          "license": {
            "type": "string",
            "title": "License",
            "default": "apache-2.0"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "export_dir",
          "hf_repo"
        ],
        "title": "PublishRequest"
      },
      "TrainingStartRequest": {
        "properties": {
          "model": {
            "type": "string",
            "maxLength": 200,
            "title": "Model"
          },
          "dataset": {
            "type": "string",
            "maxLength": 100,
            "title": "Dataset"
          },
          "mode": {
            "type": "string",
            "pattern": "^(vl|text)$",
            "title": "Mode",
            "default": "vl"
          },
          "quant": {
            "type": "string",
            "pattern": "^(bf16|4bit|8bit)$",
            "title": "Quant",
            "default": "bf16"
          },
          "lora_r": {
            "type": "integer",
            "maximum": 256.0,
            "minimum": 1.0,
            "title": "Lora R",
            "default": 16
          },
          "lora_alpha": {
            "type": "integer",
            "maximum": 512.0,
            "minimum": 1.0,
            "title": "Lora Alpha",
            "default": 32
          },
          "epochs": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Epochs",
            "default": 3
          },
          "batch_size": {
            "type": "integer",
            "maximum": 32.0,
            "minimum": 1.0,
            "title": "Batch Size",
            "default": 1
          },
          "learning_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 1e-07,
            "title": "Learning Rate",
            "default": 0.0002
          },
          "max_steps": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Max Steps",
            "default": 0
          },
          "wandb_project": {
            "type": "string",
            "maxLength": 100,
            "title": "Wandb Project",
            "default": ""
          },
          "wandb_entity": {
            "type": "string",
            "maxLength": 100,
            "title": "Wandb Entity",
            "default": ""
          },
          "smoke": {
            "type": "boolean",
            "title": "Smoke",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "model",
          "dataset"
        ],
        "title": "TrainingStartRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
